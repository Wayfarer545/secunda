# Окружение: dev или prod
APP_ENV=dev

# Подключение к PostgreSQL и RabbitMQ (для локального запуска без docker;
# в docker compose адреса прибиты в docker-compose.yml, эти значения игнорируются)
DATABASE_URL=postgresql+asyncpg://secunda:secunda@localhost:5432/secunda
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# API-ключ для авторизации запросов (в prod дефолтное значение запрещено)
API_KEY=dev-api-key

# Уровень логирования; пусто = DEBUG в dev, INFO в prod
LOG_LEVEL=

# Таймаут доставки вебхука, сек
WEBHOOK_TIMEOUT=10.0

# Интервал опроса outbox, сек
OUTBOX_POLL_INTERVAL=1.0

# Размер пачки сообщений outbox за один проход
OUTBOX_BATCH_SIZE=100

# Эмуляция платёжного шлюза: доля успешных платежей и границы задержки, сек
GATEWAY_SUCCESS_RATE=0.9
GATEWAY_DELAY_MIN=2.0
GATEWAY_DELAY_MAX=5.0
